# Copiar este archivo como etl/.env y completar con SUS datos locales.
# etl/.env está en .gitignore: NUNCA se sube al repositorio.

DB_HOST=localhost
DB_PORT=1521
# Servicio de la PDB: XEPDB1 (Oracle XE 18c/21c) o FREEPDB1 (Oracle 23ai Free)
DB_SERVICE=XEPDB1

# Usuario dueño de las tablas STG_* (el de "ConexionProyecto" en SQL Developer)
SRC_USER=usuario_fuente
SRC_PASSWORD=cambiar

# Esquema del Data Warehouse (creado con sql/dw/00_crear_usuario_dw.sql)
DW_USER=DW_INVACOM
DW_PASSWORD=cambiar
